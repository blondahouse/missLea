{
  "name": "misslea-cloudflare-only-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --test test/*.test.mjs",
    "build:check": "wrangler deploy --dry-run --outdir=.wrangler-dry-run",
    "deploy": "wrangler deploy",
    "check:core": "node --test ../agent_core/test/*.test.mjs test/autonomous_support.test.mjs",
    "build:core": "wrangler deploy --config wrangler.agent-core.toml --dry-run --outdir=.wrangler-core-dry-run",
    "check:memory": "node --test ../living_memory/test/*.test.mjs",
    "build:memory": "wrangler deploy --config wrangler.memory-smoke.toml --dry-run --outdir=.wrangler-memory-dry-run",
    "check:integrated": "node --test ../agent_core/test/*.test.mjs ../living_memory/test/*.test.mjs test/integrated_support.test.mjs",
    "build:integrated": "wrangler deploy --config wrangler.core-memory.toml --dry-run --outdir=.wrangler-integrated-dry-run"
  },
  "dependencies": {
    "agents": "0.33.0"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  }
}
